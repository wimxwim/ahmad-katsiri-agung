# Google Sheets API — Service Account Credentials
# 1. Buat project di https://console.cloud.google.com
# 2. Enable Google Sheets API
# 3. Buat Service Account → download JSON key
# 4. Copy client_email dan private_key dari JSON key
GOOGLE_SHEETS_CLIENT_EMAIL="service-account-name@project-id.iam.gserviceaccount.com"
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID="your-google-sheet-id"

# Telegram Bot
# 1. Chat @BotFather → /newbot → dapatkan token
# 2. Chat @userinfobot → dapatkan chat_id
TELEGRAM_BOT_TOKEN="123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11"
TELEGRAM_CHAT_ID="123456789"
TELEGRAM_CHAT_ID_2="987654321"

# Security — JWT secret untuk verifikasi siswa (min 32 karakter)
JWT_SECRET="your-random-secret-key-at-least-32-characters-long"

# Security — API key untuk akses rekap nilai di /pendidik
ADMIN_API_KEY="your-admin-api-key"

# Keystatic CMS
# ⚠️ KEAMANAN: /keystatic route di production diblokir kecuali eksplisit dikonfigurasi.
# ⚠️ JANGAN set storage kind selain "local" di development tanpa GitHub App credentials.
#
# Local mode (development): set ke "local" + buka http://localhost:3000/keystatic
# GitHub mode (production): set ke "github" + isi 3 env var di bawah
#
# Untuk development:
NEXT_PUBLIC_KEYSTATIC_STORAGE_KIND="local"
#
# Untuk production (hanya jika storage kind = "github"):
# Buat GitHub App → Settings → Developer settings → GitHub Apps → New GitHub App
# Permission: Contents (Read & Write), Pull Requests (Read & Write)
KEYSTATIC_GITHUB_CLIENT_ID=""
KEYSTATIC_GITHUB_CLIENT_SECRET=""
KEYSTATIC_SECRET=""

# Application toggle — set ke "true" untuk mengaktifkan CMS data override
NEXT_PUBLIC_USE_CMS="false"
