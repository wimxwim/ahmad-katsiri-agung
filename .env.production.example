# ============================================================
# AKAL Center — Environment Variables (Production VPS)
# Copy to /opt/akal-center/.env.production
# chmod 600 /opt/akal-center/.env.production
# ============================================================

# --- Database (Supabase — external) ---
DATABASE_URL="postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"

# --- AI (NaraRouter) ---
AI_API_KEY="sk-nry-YOUR_KEY"
NARAROUTER_API_KEY="sk-nry-YOUR_KEY"
AI_MODEL="gpt-5.6-luna"
AI_FLASH_MODEL="gpt-5.6-luna"
AI_BASE_URL="https://router.bynara.id/v1"

# --- JWT ---
JWT_SECRET="YOUR_64_CHAR_RANDOM_STRING_CHANGE_ME"

# --- Encryption ---
ENCRYPTION_SECRET="YOUR_64_CHAR_RANDOM_STRING_CHANGE_ME"

# --- Google OAuth ---
GOOGLE_CLIENT_ID="YOUR_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_CLIENT_SECRET"

# --- ImageKit (Storage PDF) ---
IMAGEKIT_PUBLIC_KEY="YOUR_PUBLIC_KEY"
IMAGEKIT_PRIVATE_KEY="YOUR_PRIVATE_KEY"
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/YOUR_ID"

# --- Redis (Upstash — external) ---
UPSTASH_REDIS_REST_URL="https://YOUR.upstash.io"
UPSTASH_REDIS_REST_TOKEN="YOUR_TOKEN"

# --- Email (Resend) ---
RESEND_API_KEY="YOUR_RESEND_KEY"

# --- Cron Secret ---
CRON_SECRET="YOUR_32_CHAR_RANDOM_STRING_CHANGE_ME"

# --- Payment (Midtrans — optional) ---
MIDTRANS_SERVER_KEY="YOUR_SERVER_KEY"
MIDTRANS_CLIENT_KEY="YOUR_CLIENT_KEY"

# --- Next.js ---
NEXT_PUBLIC_APP_URL="https://akalcenter.my.id"
NODE_ENV="production"