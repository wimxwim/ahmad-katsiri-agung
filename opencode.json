{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "model": "nararouter/deepseek-v4-pro-bynara",
  "default_agent": "build",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    }
  },
  "agent": {
    "build": {
      "prompt": ".opencode/agents/build.md",
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    },
    "plan": {
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "mentor": {
      "prompt": ".opencode/agents/mentor.md",
      "mode": "primary",
      "tools": {
        "write": false,
        "edit": false,
        "bash": false,
        "read": true,
        "grep": true,
        "glob": true,
        "skill": true
      },
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    }
  }
}
