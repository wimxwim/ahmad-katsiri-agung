{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "instructions": ["AGENTS.md"],
  "subagent_depth": 3,
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true
    },
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "/home/ngome/agensi/proyek/akal-center"],
      "enabled": true
    }
  },
  "agent": {
    "build": {
      "prompt": ".opencode/agents/build.md",
      "steps": 30
    },
    "mentor": {
      "description": "Profesor Senior Arsitek — analisis arsitektur, review kode, evidence-based, read-only",
      "prompt": ".opencode/agents/mentor.md",
      "mode": "primary",
      "tools": {
        "write": false,
        "edit": false,
        "bash": false,
        "read": true,
        "grep": true,
        "glob": true,
        "skill": true
      },
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    }
  }
}
