# ============================================================
# AKAL Center — Docker Environment (pakai Supabase external)
# ============================================================

# --- Database (Supabase external) ---
DATABASE_URL="postgresql://postgres.xxx:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"

# --- AI (NaraRouter) ---
AI_API_KEY="sk-nry-YOUR_KEY"
AI_MODEL="deepseek-v4-flash"
AI_FLASH_MODEL="deepseek-v4-flash"
AI_BASE_URL="https://router.bynara.id/v1"

# --- JWT ---
JWT_SECRET="super-secret-key-minimum-32-characters-change-me-now"

# --- Encryption ---
ENCRYPTION_SECRET="encryption-secret-key-minimum-32-characters-change-me"

# --- Google OAuth (skip sementara) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- ImageKit (Storage PDF) ---
IMAGEKIT_PUBLIC_KEY="public_xxx"
IMAGEKIT_PRIVATE_KEY="private_xxx"
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/xxx"

# --- Redis (Upstash external) ---
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxx"

# --- Email (Resend) ---
RESEND_API_KEY="re_xxx"

# --- Payment (skip) ---
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""

# --- Next.js ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NODE_ENV="production"

# --- Cron ---
CRON_SECRET="akal-cron-secret-docker"